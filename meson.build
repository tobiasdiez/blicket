# The version comes from pyproject.toml; meson-python prefers it over project(version:).
project('blicket', meson_version: '>= 1.5')

py = import('python').find_installation(pure: true)

# Explicit file lists: install_subdir would also pick up nested __pycache__ and editor files.
# tests/test_packaging.py checks that every file under src/blicket is listed here.
py.install_sources(
  'src/blicket/__init__.py',
  'src/blicket/_validation.py',
  'src/blicket/assembly.py',
  'src/blicket/builder.py',
  'src/blicket/cli.py',
  'src/blicket/comparison.py',
  'src/blicket/config.py',
  'src/blicket/definitions.py',
  'src/blicket/discovery.py',
  'src/blicket/errors.py',
  'src/blicket/loader.py',
  'src/blicket/manifest.py',
  'src/blicket/model.py',
  'src/blicket/py.typed',
  'src/blicket/report.py',
  'src/blicket/schema.py',
  'src/blicket/serve.py',
  'src/blicket/store.py',
  'src/blicket/tables.py',
  'src/blicket/tracebacks.py',
  'src/blicket/viewer.py',
  subdir: 'blicket',
)

py.install_sources(
  'src/blicket/plots/__init__.py',
  'src/blicket/plots/_base.py',
  'src/blicket/plots/_diff.py',
  'src/blicket/plots/bar.py',
  'src/blicket/plots/line.py',
  'src/blicket/plots/stacked_area.py',
  subdir: 'blicket/plots',
)

# The viewer: a static site generated by Nuxt. meson output names cannot hold path segments, so
# the script copies viewer/.output/public into the target directory, installed as
# blicket/_viewer. Always stale: meson cannot see the viewer's sources change.
pnpm = find_program('pnpm', required: get_option('viewer'))
if pnpm.found()
  custom_target(
    'viewer',
    output: '_viewer',
    command: [py, files('viewer/generate.py'), pnpm, meson.current_source_dir() / 'viewer', '@OUTPUT@'],
    build_always_stale: true,
    install: true,
    install_dir: py.get_install_dir() / 'blicket',
  )
endif
